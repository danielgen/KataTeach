# Experiment artifacts are immutable local data products. Keep pipeline code in
# git, but never accidentally stage archived invalid results or multi-GB runs.
daniele_experiment/artifacts/archive/*/files/
daniele_experiment/artifacts/runs/
daniele_experiment/artifacts/causal/
daniele_experiment/artifacts/logs/
daniele_experiment/artifacts/protocols/

